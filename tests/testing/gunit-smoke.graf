suite$ = box {
	common.testing.gunit.test>> verify-assertions(): (
		common.testing.gunit.assert(yes);
		common.testing.gunit.assert-equals(3, 3);
		common.testing.gunit.assert-not-equals(3, 4)
	),

	common.testing.gunit.test>> verify-expected-failure(): common.testing.gunit.assert-fails {missing},

	common.testing.gunit.test>> verify-class-filter(): common.testing.gunit.assert-fails {
		common.evaluation.error-handling.label-not-found-exception,
		missing
	},

	common.testing.gunit.test>> verify-continues-after-failure(): (
		inner$ = box {
			common.testing.gunit.test>> broken(): missing,
			common.testing.gunit.test>> healthy(): 42
		};
		report$ = common.testing.gunit.test-report(inner$);
		common.testing.gunit.assert-equals(1, report$.passed);
		common.testing.gunit.assert-equals(1, report$.failed)
	),

	common.testing.gunit.test>> verify-setup-failure(): (
		inner$ = (mutable>> box {
			calls: 0,
			common.testing.gunit.setup>> prepare(): missing,
			common.testing.gunit.test>> self$.guarded(): self$.calls := self$.calls.plus(1)
		});
		report$ = common.testing.gunit.test-report(inner$);
		common.testing.gunit.assert-equals(0, report$.passed);
		common.testing.gunit.assert-equals(1, report$.failed);
		common.testing.gunit.assert-equals(0, inner$.calls)
	)
};

suite$
