// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-petroleum-barrels(): (
		q$ = units.petroleum-barrels(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 3, 0, 0, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.volume?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.petroleum-barrels}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {0.317974589856(0)}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.petroleum-barrels(q$).value()})
	),
	common.testing.gunit.test>> verify-grams(): (
		q$ = units.grams(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 0, 1, 0, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.mass?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.grams}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {0.002(0)}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.grams(q$).value()})
	),
