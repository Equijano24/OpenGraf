		common.testing.gunit.assert-equals(tuple {units.kilometers}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2000}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.kilometers(q$).value()})
	),
