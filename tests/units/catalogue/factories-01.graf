// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-meters(): (
		q$ = units.meters(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 1, 0, 0, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.length?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.meters}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.meters(q$).value()})
	),
	common.testing.gunit.test>> verify-kilometers(): (
		q$ = units.kilometers(2);
