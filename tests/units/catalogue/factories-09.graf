		common.testing.gunit.assert-equals(tuple {units.kilograms-per-cubic-meter-concentration}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.kilograms-per-cubic-meter-concentration(q$).value()})
	),
