		common.testing.gunit.assert-equals(tuple {units.moles-per-cubic-meter}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.moles-per-cubic-meter(q$).value()})
	),
