// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-kilograms-per-mole(): (
		q$ = units.kilograms-per-mole(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 0, 1, 0, 0, 0, -1, 0, 0},
			tuple {q$.value(), match(q$, units.molar-mass?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.kilograms-per-mole}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.kilograms-per-mole(q$).value()})
	),
	common.testing.gunit.test>> verify-moles-per-cubic-meter(): (
		q$ = units.moles-per-cubic-meter(2);
		common.testing.gunit.assert-equals(tuple {2, yes, -3, 0, 0, 0, 0, 1, 0, 0},
