// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-centipoise(): (
		q$ = units.centipoise(2);
		common.testing.gunit.assert-equals(tuple {2, yes, -1, 1, -1, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.dynamic-viscosity?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.centipoise}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {0.002(0)}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.centipoise(q$).value()})
	),
	common.testing.gunit.test>> verify-stokes(): (
		q$ = units.stokes(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 2, 0, -1, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.kinematic-viscosity?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.stokes}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {0.0002(0)}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.stokes(q$).value()})
	),
