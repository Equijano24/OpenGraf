// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-square-kilometers(): (
		q$ = units.square-kilometers(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 2, 0, 0, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.area?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.square-kilometers}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2000000}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.square-kilometers(q$).value()})
	),
	common.testing.gunit.test>> verify-cubic-kilometers(): (
		q$ = units.cubic-kilometers(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 3, 0, 0, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.volume?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.cubic-kilometers}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2000000000}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.cubic-kilometers(q$).value()})
	),
