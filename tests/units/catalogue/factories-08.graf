		common.testing.gunit.assert-equals(tuple {units.webers}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.webers(q$).value()})
	),
