// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-pebibits(): (
		q$ = units.pebibits(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 0, 0, 0, 0, 0, 0, 0, 1},
			tuple {q$.value(), match(q$, units.information?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.pebibits}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2251799813685248}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.pebibits(q$).value()})
	),
	common.testing.gunit.test>> verify-exbibytes(): (
