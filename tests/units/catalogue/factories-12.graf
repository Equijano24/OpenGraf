		common.testing.gunit.assert-equals(tuple {units.exbibytes}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {18446744073709551616}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.exbibytes(q$).value()})
	),
