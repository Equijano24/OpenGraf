import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-radians(): (
		q$ = units.radians(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 0, 0, 0, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.angle?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.radians}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.radians(q$).value()})
	),
