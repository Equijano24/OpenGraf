// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-kilogram-square-meters(): (
		q$ = units.kilogram-square-meters(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 2, 1, 0, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.moment-of-inertia?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.kilogram-square-meters}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.kilogram-square-meters(q$).value()})
	),
	common.testing.gunit.test>> verify-meters-to-the-fourth(): (
		q$ = units.meters-to-the-fourth(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 4, 0, 0, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.area-moment-of-inertia?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.meters-to-the-fourth}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.meters-to-the-fourth(q$).value()})
	),
