// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-kilonewtons(): (
		q$ = units.kilonewtons(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 1, 1, -2, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.force?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.kilonewtons}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {2000}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.kilonewtons(q$).value()})
	),
	common.testing.gunit.test>> verify-dynes(): (
		q$ = units.dynes(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 1, 1, -2, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.force?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.dynes}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {0.00002(0)}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.dynes(q$).value()})
	),
