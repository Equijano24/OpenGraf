// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-kilowatt-hours(): (
		q$ = units.kilowatt-hours(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 2, 1, -2, 0, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.energy?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.kilowatt-hours}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {7200000}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.kilowatt-hours(q$).value()})
	),
	common.testing.gunit.test>> verify-thermochemical-calories(): (
		q$ = units.thermochemical-calories(2);
