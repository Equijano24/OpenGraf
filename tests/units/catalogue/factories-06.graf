		common.testing.gunit.assert-equals(tuple {units.thermochemical-calories}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {8.368(0)}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.thermochemical-calories(q$).value()})
	),
