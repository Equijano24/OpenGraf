// Generated construction checks; special rules have independent hand-written tests.
import(units: graf {path: "../../../src/units"});
box {
	common.testing.gunit.test>> verify-kelvins(): (
		q$ = units.kelvins(2);
		common.testing.gunit.assert-equals(tuple {2, units.kelvins, yes},
			tuple {q$.value(), q$.factory, match(q$, all(units.quantity?)?)});
		common.testing.gunit.assert-fails {q$.amount := 3}
	),
