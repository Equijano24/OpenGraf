// Generated integration checks; see catalogue-anchors.graf for independent anchors.
import(units: graf {path: "../../../src/units"});

box {
	common.testing.gunit.test>> verify-millihenries(): (
		q$ = units.millihenries(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 2, 1, -2, -2, 0, 0, 0, 0},
			tuple {q$.value(), match(q$, units.inductance?), q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information});
		common.testing.gunit.assert-equals(tuple {units.millihenries}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {0.002(0)}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.millihenries(q$).value()})
	),
	common.testing.gunit.test>> verify-microteslas(): (
		q$ = units.microteslas(2);
		common.testing.gunit.assert-equals(tuple {2, yes, 0, 1, -2, -1, 0, 0, 0, 0},
