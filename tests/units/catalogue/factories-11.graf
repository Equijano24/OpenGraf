		common.testing.gunit.assert-equals(tuple {units.microteslas}, tuple {q$.factory});
		common.testing.gunit.assert-equals(tuple {0.000002(0)}, tuple {q$.coherent-value()});
		common.testing.gunit.assert-equals(tuple {2}, tuple {units.microteslas(q$).value()})
	),
