import(units: graf {path: "../../src/units"});

box {
	common.testing.gunit.test>> verify-ratio-dimension(): (
		factory$ = units.ratio.definition("test-ratio", "u", 1);
		q$ = factory$(7);
		common.testing.gunit.assert(match(q$, units.ratio?));
		common.testing.gunit.assert(match(q$, units.unit?));
		common.testing.gunit.assert-equals("ratio", q$.kind);
		common.testing.gunit.assert-equals(tuple { 0, 0, 0, 0, 0, 0, 0, 0 },
			tuple { q$.dimension.length, q$.dimension.mass, q$.dimension.duration, q$.dimension.current, q$.dimension.temperature, q$.dimension.amount-of-substance, q$.dimension.luminous-intensity, q$.dimension.information });
		common.testing.gunit.assert-equals(7, q$.value())
	),

	common.testing.gunit.test>> verify-angle-dimension(): (
		factory$ = units.angle.definition("test-angle", "u", 1);
		q$ = factory$(7);
