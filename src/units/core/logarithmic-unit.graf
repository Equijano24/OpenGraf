import(open-graf-units-core: graf {path: "."});

family$ = open-graf-units-core.unit.family("logarithmic-ratio",
	open-graf-units-core.dimension(0, 0, 0, 0, 0, 0, 0, 0));

// The logarithm is a mapping, never a linear scale factor.
heir(family$) {
	logarithm: default(string?, "decimal")?,
	coefficient: default(real?, 1)?,
	override>> scale: 1,
	override>> linear-arithmetic: no,

	override>> self$.quantity(amount$ = number?): (
		real? >> amount$;
		composite>> new(self$) {amount: amount$, factory: self$}
	),

	override>> self$.is-convertible-from(source$ = open-graf-units-core.quantity?):
		self$.compatible-with(source$),

	self$.logarithmic-definition(id$ = string?, symbol$ = string?, kind$ = string?,
		logarithm$ = string?, coefficient$ = real?, source$ = string?): (
		yes? >> equals(logarithm$, "decimal").or(equals(logarithm$, "natural"));
		no? >> coefficient$.equal-to(0);
		common.math.gt(0)? >> kind$.length();
		definition$ = self$.definition(id$, symbol$, 1, no, yes, source$);
		heir(definition$) {
			override>> kind: kind$,
			override>> logarithm: logarithm$,
			override>> coefficient: coefficient$
		}
	),

	self$.ratio-value(amount$ = real?, precision$ = integer?): (
		exponent$ = amount$.exact-quotient(self$.coefficient);
		ratio$ = if(equals(self$.logarithm, "decimal")) {
			10.pow(exponent$, precision$), common.math.exp(exponent$, precision$)
		};
		common.math.gt(0)? >> ratio$;
		ratio$
	),

	self$.level-value(ratio$ = real?, precision$ = integer?): (
		common.math.gt(0)? >> ratio$;
		log$ = if(equals(self$.logarithm, "decimal")) {
			common.math.log10(ratio$, precision$), common.math.ln(ratio$, precision$)
		};
		log$.exact-product(self$.coefficient)
	),

	self$.linear-ratio(precision$ = default(integer?, 15)?):
		self$.factory.ratio-value(self$.value(), precision$),

	self$.level(ratio$ = real?, precision$ = default(integer?, 15)?):
		self$.quantity(self$.level-value(ratio$, precision$)),

	self$(amount$ = number?): self$.quantity(amount$),

	self$(source$ = open-graf-units-core.quantity?): self$(source$, 15),

	self$(source$ = open-graf-units-core.quantity?, precision$ = integer?): (
		yes? >> self$.compatible-with(source$);
		if(equals(self$, source$.factory)) {
			self$.quantity(source$.value()), self$.converted-reading(source$, precision$)
		}
	),

	// Same logarithm: the readings differ by an exact coefficient. A different
	// logarithm still goes through the linear ratio at the requested precision.
	self$.converted-reading(source$ = open-graf-units-core.quantity?, precision$ = integer?): (
		if(equals(self$.logarithm, source$.logarithm)) {
			(
				factor$ = self$.coefficient.exact-quotient(source$.coefficient);
				self$.quantity(source$.value().exact-product(factor$))
			),
			self$.level(source$.linear-ratio(precision$), precision$)
		}
	),

	override>> self$.value-in-self(other$ = open-graf-units-core.quantity?): (
		yes? >> self$.compatible-with(other$);
		if(equals(self$.factory, other$.factory)) {
			other$.value(), self$.factory.converted-reading(other$, 15).value()
		}
	),

	override>> self$.coherent-value-of(amount$ = number?, precision$ = default(integer?, 15)?):
		self$.ratio-value(amount$, precision$),

	override>> self$.display-value-of(amount$ = number?, precision$ = default(integer?, 15)?):
		self$.level-value(amount$, precision$)
}
