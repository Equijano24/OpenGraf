import(open-graf-units-core: graf {path: "."});

// Families and definitions are heirs; a numeric call creates a sealed instance.
class {
	amount: number?,
	factory: class?,
	id: string?,
	symbol: string?,
	kind: string?,
	dimension: open-graf-units-core.dimension?,
	scale: real?,
	offset: default(real?, 0)?,
	linear-arithmetic: bool?,
	prefixable: default(bool?, no)?,
	exact: default(bool?, yes)?,
	source: default(string?, "user-defined")?,

	self$(amount$ = number?): self$.quantity(amount$),

	self$.quantity(amount$ = number?):
		composite>> new(self$) {amount: amount$, factory: self$},

	self$(source$ = open-graf-units-core.quantity?): (
		yes? >> self$.is-convertible-from(source$);
		coherent$ = source$.coherent-value();
		amount$ = self$.display-value-of(coherent$);
		self$.quantity(amount$)
	),

	self$.value(): self$.amount,

	self$.is-compound(): no,

	self$.is-convertible-from(source$ = open-graf-units-core.quantity?):
		self$.compatible-with(source$).or(
			source$.is-compound().and(self$.dimension.same-as(source$.dimension))
		),

	self$.coherent-value-of(amount$ = number?): (
		scaled$ = if(equals(self$.scale, 1)) {amount$, amount$.times(self$.scale)};
		if(equals(self$.offset, 0)) {scaled$, scaled$.plus(self$.offset)}
	),

	self$.display-value-of(amount$ = number?): (
		shifted$ = if(equals(self$.offset, 0)) {amount$, amount$.minus(self$.offset)};
		if(equals(self$.scale, 1)) {shifted$, shifted$.over(self$.scale)}
	),

	self$.coherent-value(): self$.factory.coherent-value-of(self$.value()),

	self$.require-linear(): (
		yes? >> self$.linear-arithmetic;
		0? >> self$.offset;
		return(void)
	),

	self$.value-in-self(other$ = open-graf-units-core.quantity?): (
		yes? >> self$.compatible-with(other$);
		self$.factory.display-value-of(other$.coherent-value())
	),

	self$.plus(other$ = open-graf-units-core.quantity?): (
		self$.require-linear();
		other$.require-linear();
		other-value$ = self$.value-in-self(other$);
		amount$ = self$.value().plus(other-value$);
		self$.quantity-with-value(amount$)
	),

	self$.minus(other$ = open-graf-units-core.quantity?): (
		self$.require-linear();
		other$.require-linear();
		other-value$ = self$.value-in-self(other$);
		amount$ = self$.value().minus(other-value$);
		self$.quantity-with-value(amount$)
	),

	self$.times(other$ = any(number?, open-graf-units-core.quantity?)?): (
		self$.require-linear();
		if(match(other$, number?)) {
			(
				amount$ = self$.value().times(other$);
				self$.quantity-with-value(amount$)
			),
			(
				other$.require-linear();
				amount$ = self$.coherent-value().times(other$.coherent-value());
				dimension$ = self$.dimension.times(other$.dimension);
				open-graf-units-core.compound(amount$, dimension$)
			)
		}
	),

	self$.over(other$ = any(number?, open-graf-units-core.quantity?)?): (
		self$.require-linear();
		if(match(other$, number?)) {
			(
				amount$ = self$.value().over(other$);
				self$.quantity-with-value(amount$)
			),
			(
				other$.require-linear();
				amount$ = self$.coherent-value().over(other$.coherent-value());
				dimension$ = self$.dimension.over(other$.dimension);
				open-graf-units-core.compound(amount$, dimension$)
			)
		}
	),

	self$.pow(exponent$ = integer?): (
		self$.require-linear();
		amount$ = self$.coherent-value().pow(exponent$);
		dimension$ = self$.dimension.pow(exponent$);
		open-graf-units-core.compound(amount$, dimension$)
	),

	self$.root(degree$ = integer?, precision$ = default(integer?, 15)?): (
		self$.require-linear();
		dimension$ = self$.dimension.root(degree$);
		amount$ = self$.coherent-value().root(degree$, precision$);
		open-graf-units-core.compound(amount$, dimension$)
	),

	self$.rounded(places$ = integer?): (
		amount$ = self$.value().round(places$);
		self$.quantity-with-value(amount$)
	),

	self$.compared-to(other$ = open-graf-units-core.quantity?): self$.value().compared-to(self$.value-in-self(other$)),
	self$.equal-to(other$ = open-graf-units-core.quantity?): self$.value().equal-to(self$.value-in-self(other$)),
	self$.lt(other$ = open-graf-units-core.quantity?): self$.value().lt(self$.value-in-self(other$)),
	self$.lte(other$ = open-graf-units-core.quantity?): self$.value().lte(self$.value-in-self(other$)),
	self$.gt(other$ = open-graf-units-core.quantity?): self$.value().gt(self$.value-in-self(other$)),
	self$.gte(other$ = open-graf-units-core.quantity?): self$.value().gte(self$.value-in-self(other$)),

	self$.quantity-with-value(amount$ = number?): self$.factory.quantity(amount$),

	self$.compatible-with(other$ = box {kind: string?, dimension: all(open-graf-units-core.dimension?)?}?):
		equals(self$.kind, other$.kind).and(self$.dimension.same-as(other$.dimension)),

	self$.family(kind$ = string?, dimension$ = open-graf-units-core.dimension?): (
		common.math.gt(0)? >> kind$.length();
		heir(self$) {
			override>> kind: kind$,
			override>> linear-arithmetic: yes,
			override>> dimension: open-graf-units-core.dimension(
				dimension$.length, dimension$.mass, dimension$.duration,
				dimension$.current, dimension$.temperature, dimension$.amount-of-substance,
				dimension$.luminous-intensity, dimension$.information)
		}
	),

	self$.definition(id$ = string?, symbol$ = string?, scale$ = real?):
		self$.definition(id$, symbol$, scale$, no, yes, "user-defined"),

	self$.definition(id$ = string?, symbol$ = string?, scale$ = real?,
		prefixable$ = bool?, exact$ = bool?, source$ = string?): (
		common.math.gt(0)? >> scale$;
		common.math.gt(0)? >> id$.length();
		heir(self$) {
			override>> id: id$,
			override>> symbol: symbol$,
			override>> scale: scale$,
			override>> prefixable: prefixable$,
			override>> exact: exact$,
			override>> source: source$
		}
	)
}
