import(open-graf-units-core: graf {path: "."});

// A referenced level is a unit instance that retains both the reference and convention.
heir(open-graf-units-core.logarithmic-unit) {
	reference: all(open-graf-units-core.quantity?)?,
	convention: class?,

	override>> self$(amount$ = number?): self$.quantity(amount$),

	self$(source$ = open-graf-units-core.quantity?): self$.level-from(source$, 15),

	self$(reference$ = open-graf-units-core.quantity?, convention$ = class?): (
		reference$.require-linear();
		common.math.gt(0)? >> reference$.coherent-value();
		yes? >> equals(convention$.kind, "power-level").or(equals(convention$.kind, "amplitude-level"));
		definition$ = self$.definition(convention$.id.conc("-referenced"), convention$.symbol,
			1, no, yes, convention$.source);
		heir(definition$) {
			override>> reference: reference$,
			override>> convention: convention$,
			override>> kind: "referenced-".conc(convention$.kind),
			override>> logarithm: convention$.logarithm,
			override>> coefficient: convention$.coefficient
		}
	),

	override>> self$.compatible-with(other$ = box {kind: string?, dimension: all(open-graf-units-core.dimension?)?}?):
		if(equals(self$.kind, other$.kind).and(self$.dimension.same-as(other$.dimension))) {
			self$.reference.compatible-with(other$.reference), no
		},

	override>> self$.is-convertible-from(source$ = open-graf-units-core.quantity?): (
		if(equals(source$.kind, self$.kind)) {
			self$.compatible-with(source$), self$.reference.compatible-with(source$)
		}
	),

	override>> self$.coherent-value-of(amount$ = number?, precision$ = default(integer?, 15)?):
		self$.ratio-value(amount$, precision$).exact-product(self$.reference.coherent-value()),

	override>> self$.display-value-of(amount$ = number?, precision$ = default(integer?, 15)?):
		self$.level-value(amount$.exact-quotient(self$.reference.coherent-value()), precision$),

	self$.physical-value(precision$ = default(integer?, 15)?):
		self$.linear-ratio(precision$).exact-product(self$.reference.coherent-value()),

	self$.linear-quantity(precision$ = default(integer?, 15)?): (
		amount$ = self$.reference.value().exact-product(self$.linear-ratio(precision$));
		self$.reference.factory.quantity(amount$)
	),

	self$.level(value$ = open-graf-units-core.quantity?, precision$ = default(integer?, 15)?): (
		value$.require-linear();
		yes? >> self$.reference.compatible-with(value$);
		ratio$ = value$.coherent-value().exact-quotient(self$.reference.coherent-value());
		self$.quantity(self$.level-value(ratio$, precision$))
	),

	self$(source$ = open-graf-units-core.quantity?, precision$ = integer?): self$.level-from(source$, precision$),

	override>> self$.value-in-self(other$ = open-graf-units-core.quantity?): (
		yes? >> self$.compatible-with(other$);
		if(equals(self$.factory, other$.factory)) {
			other$.value(), self$.factory.level-from(other$, 15).value()
		}
	),

	self$.level-from(source$ = open-graf-units-core.quantity?, precision$ = integer?): (
		yes? >> self$.is-convertible-from(source$);
		if(equals(self$, source$.factory)) {
			self$.quantity(source$.value()), self$.reading-from(source$, precision$)
		}
	),

	self$.reading-from(source$ = open-graf-units-core.quantity?, precision$ = integer?): (
		if(equals(source$.kind, self$.kind)) {
			self$.same-kind-reading(source$, precision$), self$.linear-reading(source$, precision$)
		}
	),

	self$.same-kind-reading(source$ = open-graf-units-core.quantity?, precision$ = integer?): (
		if(equals(self$.logarithm, source$.logarithm)) {
			(
				factor$ = self$.coefficient.exact-quotient(source$.coefficient);
				scaled$ = source$.value().exact-product(factor$);
				shift$ = self$.level-value(
					source$.reference.coherent-value().exact-quotient(self$.reference.coherent-value()),
					precision$);
				self$.quantity(scaled$.plus(shift$))
			),
			self$.linear-reading(source$, precision$)
		}
	),

	self$.linear-reading(source$ = open-graf-units-core.quantity?, precision$ = integer?): (
		value$ = source$.coherent-value(precision$);
		ratio$ = value$.exact-quotient(self$.reference.coherent-value());
		self$.quantity(self$.level-value(ratio$, precision$))
	)
}
